{
  "name": "n8n-nodes-usemjml",
  "version": "0.1.0",
  "description": "n8n community node for usemjml.com — render MJML to responsive email HTML and validate MJML templates.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "mjml",
    "usemjml",
    "email",
    "html",
    "newsletter",
    "template"
  ],
  "license": "MIT",
  "homepage": "https://usemjml.com",
  "author": {
    "name": "Tim Lochmüller",
    "email": "tim@usemjml.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usemjml/n8n.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/UseMjmlApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/UseMjml/UseMjmlRender.node.js",
      "dist/nodes/UseMjml/UseMjmlValidate.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.46.2",
    "@types/node": "^22.10.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
